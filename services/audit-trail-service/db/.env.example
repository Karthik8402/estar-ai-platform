# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://epharmic:change-me-in-development@localhost:5432/epharmic_db
# Optional fallback if the primary host is unreachable (for example, DNS issues)
DATABASE_URL_FALLBACK=
DB_CONNECT_TIMEOUT_SECONDS=8
DB_KEEPALIVES=1
DB_KEEPALIVES_IDLE_SECONDS=30
DB_KEEPALIVES_INTERVAL_SECONDS=10
DB_KEEPALIVES_COUNT=5

# Agent safety bound for recovery scans
AGENT_MAX_LOOKBACK_MINUTES=30

# ─── JWT (deferred — not enforced yet) ─────────────
JWT_SECRET=change-me-in-development
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15

# ─── AI Provider ───────────────────────────────────
# Options: gemini (free/dev), openai (production)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Service ───────────────────────────────────────
SERVICE_NAME=audit-trail-service
SERVICE_VERSION=1.0.0
SERVICE_PORT=8001

# ─── Docker PostgreSQL ─────────────────────────────
# If using Docker: docker run -d --name epharmic-pg -e POSTGRES_DB=epharmic_db -e POSTGRES_USER=epharmic -e POSTGRES_PASSWORD=change-me-in-development -p 5432:5432 postgres:15
DB_PASSWORD=change-me-in-development
